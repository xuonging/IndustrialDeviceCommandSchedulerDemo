<Window x:Class="IndustrialDeviceCommandSchedulerDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="设备指令调度 Demo"
        Width="1220"
        Height="780"
        MinWidth="1060"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7DEE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="设备指令调度：同一连接内串行，设备之间并行"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"/>
                <TextBlock Text="UI、后台采集、人工控制、急停都进入 IDeviceCommandScheduler，由优先级队列和唯一 Worker 统一执行。"
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TxtUiThread"
                       DockPanel.Dock="Right"
                       Foreground="#64748B"
                       VerticalAlignment="Bottom"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="5">
            <Border Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="当前命令"/>
                    <TextBlock x:Name="TxtCurrentCommand" Style="{StaticResource MetricValue}" FontSize="21" Text="空闲"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="忙碌状态"/>
                    <TextBlock x:Name="TxtBusy" Style="{StaticResource MetricValue}" Text="Idle"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="等待队列"/>
                    <TextBlock x:Name="TxtPending" Style="{StaticResource MetricValue}" Text="0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="成功 / 失败"/>
                    <TextBlock x:Name="TxtSuccessFailed" Style="{StaticResource MetricValue}" FontSize="24" Text="0 / 0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="丢弃 / 重试 / 超时"/>
                    <TextBlock x:Name="TxtDropRetryTimeout" Style="{StaticResource MetricValue}" FontSize="21" Text="0 / 0 / 0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Text="命令入口" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,14"/>
                    <WrapPanel>
                        <Button Content="启动后台采集" Click="BtnStartBackground_Click"/>
                        <Button Content="停止后台采集" Click="BtnStopBackground_Click"/>
                    </WrapPanel>
                    <Separator Margin="0,8,0,14"/>
                    <WrapPanel>
                        <Button Content="读温度" Click="BtnReadTemperature_Click"/>
                        <Button Content="读压力" Click="BtnReadPressure_Click"/>
                        <Button Content="人工启动" Click="BtnStartMachine_Click"/>
                        <Button Content="人工停止" Click="BtnStopMachine_Click"/>
                        <Button Content="超时测试" Click="BtnSlow_Click"/>
                    </WrapPanel>
                    <Button Content="紧急停止（最高优先级）"
                            Background="#DC2626"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Margin="0,10,0,10"
                            Click="BtnEmergencyStop_Click"/>
                    <Button Content="取消页面请求" Click="BtnCancelPageRequests_Click"/>
                    <Separator Margin="0,12,0,14"/>
                    <TextBlock Text="最新响应" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock x:Name="TxtLatestResult"
                               Text="暂无"
                               TextWrapping="Wrap"
                               Foreground="#334155"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="调度日志（最近 180 条）"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                        <TextBlock x:Name="TxtTotal"
                                   DockPanel.Dock="Right"
                                   Foreground="#64748B"/>
                    </DockPanel>
                    <ListBox x:Name="LogListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding LogItems}"
                             FontFamily="Consolas"
                             FontSize="12"
                             BorderBrush="#E2E8F0"
                             BorderThickness="1"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="调度规则" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12"/>
                    <TextBlock Text="Emergency = 0" FontWeight="SemiBold" Foreground="#B91C1C"/>
                    <TextBlock Text="ManualControl = 10" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,6,0,0"/>
                    <TextBlock Text="Normal = 20" FontWeight="SemiBold" Foreground="#475569" Margin="0,6,0,0"/>
                    <TextBlock Text="Background = 30" FontWeight="SemiBold" Foreground="#64748B" Margin="0,6,0,14"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#334155" Text="同一设备连接只有一个 Worker；不同来源的命令全部进入同一个优先级队列。数字越小，优先级越高。"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#334155" Margin="0,10,0,0" Text="后台采集命令允许 CanDrop 和 CoalesceKey 去重，避免网络恢复后旧采集请求堆积。"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#334155" Margin="0,10,0,0" Text="人工控制默认不丢弃、不自动重试；急停是软件层最高优先级，但不能替代硬件安全急停。"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
